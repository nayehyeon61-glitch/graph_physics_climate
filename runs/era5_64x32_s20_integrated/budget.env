# stage20 training budget, read by chain_s20.sh when it starts (edit this file, never the running chain script).
# Default = the recommended option of the 2026-11-07 23:15 KST decision card: 3000-step paired fine-tuning from
# stage9b + a same-budget stage9b control.  Other options:
#   9000-step retraining from scratch:   STEPS=9000 LR=1e-3 INIT=scratch ROLLOUT_START=3000
#   1000 steps as in stage17-19 (+ Stage C only): STEPS=1000 LR=3e-4 INIT=s9b ROLLOUT_START=0
STEPS=3000
LR=3e-4
INIT=s9b
ROLLOUT_START=0
